# (BRAPI_API_KEY e TELEGRAM_TOKEN tambem sao aceitos)
BRAPI_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Caminho do SQLite (no Railway: Volume montado em /data; local: deixe vazio)
DB_PATH=/data/robo_trade.db
# Lista de ativos separada por virgula (vazio = lista padrao em config.py)
UNIVERSE=
# Link do Profit no alerta ({ticker} = codigo da opcao). Formato herdado da v2; a Nelogica nao documenta
# esse link, confirme no iPhone. 'off' desativa. O codigo da opcao tambem vai em toque-para-copiar.
PROFIT_LINK_TEMPLATE=https://profitchart.com.br/chart?ticker={ticker}&timeframe=5m
# true = so imprime no log, nao envia Telegram
DRY_RUN=false
# true = envia a lista de observacao as 09:30 (padrao: false)
WATCHLIST_MSG=false
